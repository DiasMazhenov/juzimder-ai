# Export this variable in the PHP process environment; .env is not auto-loaded.
# JUZIMDER_DB=/absolute/private/path/juzimder.sqlite
# Exact IPs of reverse proxies which overwrite X-Forwarded-For and X-Forwarded-Proto; no CIDR is accepted.
# JUZIMDER_TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.5
# OpenRouter credentials are configured per project in Settings → AI Engine.
