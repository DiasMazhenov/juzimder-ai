{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juzimder.local/schemas/project-v1",
  "title": "Juzimder Core document v1",
  "type": "object",
  "required": ["schemaVersion", "engine", "data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "engine": { "const": "grapesjs" },
    "data": {
      "type": "object",
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/page" }
        },
        "styles": { "type": "array" },
        "assets": { "type": "array" }
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "frames"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/frame" }
        }
      }
    },
    "frame": {
      "type": "object",
      "required": ["component"],
      "properties": {
        "component": { "$ref": "#/$defs/component" }
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["", "default", "wrapper", "text", "textnode", "image", "link", "link-block", "head", "form", "input", "textarea", "select", "option", "checkbox", "radio", "button", "label"]
        },
        "tagName": {
          "enum": ["html", "head", "body", "div", "section", "header", "footer", "nav", "main", "article", "aside", "h1", "h2", "h3", "h4", "p", "span", "a", "img", "button", "ul", "ol", "li", "strong", "em", "b", "i", "br", "hr", "label", "form", "input", "textarea", "select", "option"]
        },
        "attributes": {
          "type": "object",
          "properties": {
            "src": {"anyOf": [{"type": "string", "pattern": "^(?:https:\\/\\/[^\\s<>\\x22\\x00-\\x20]+|#[A-Za-z0-9_-]*|mailto:[A-Za-z0-9@._+-]+|tel:[+0-9 -]+|\\/api\\/projects\\/[a-f0-9]{24}\\/assets\\/[a-f0-9]{24}\\/file)$"}, {"enum": ["data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+j6J8AAAAASUVORK5CYII="]}]},
            "href": { "type": "string", "pattern": "^(?:https:\\/\\/[^\\s<>\\x22\\x00-\\x20]+|#[A-Za-z0-9_-]*|mailto:[A-Za-z0-9@._+-]+|tel:[+0-9 -]+)$" }
          }
        },
        "style": { "type": "object" },
        "content": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "head": { "$ref": "#/$defs/component" },
        "docEl": { "$ref": "#/$defs/component" }
      }
    }
  }
}
