{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juzimder.local/schemas/project-v1",
  "title": "Juzimder Core document v1",
  "type": "object",
  "required": ["schemaVersion", "engine", "data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "engine": { "const": "grapesjs" },
    "data": {
      "type": "object",
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/page" }
        },
        "styles": { "type": "array" },
        "assets": { "type": "array" }
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "frames"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/frame" }
        }
      }
    },
    "frame": {
      "type": "object",
      "required": ["component"],
      "properties": {
        "component": { "$ref": "#/$defs/component" }
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "zeroData": { "$ref": "#/$defs/zeroData" },
        "type": {
          "type": "string",
          "enum": ["", "default", "wrapper", "text", "textnode", "image", "link", "link-block", "head", "form", "input", "textarea", "select", "option", "checkbox", "radio", "button", "label", "custom-code", "countdown", "zero-block"]
        },
        "tagName": {
          "enum": ["html", "head", "body", "div", "section", "header", "footer", "nav", "main", "article", "aside", "h1", "h2", "h3", "h4", "p", "span", "a", "img", "button", "ul", "ol", "li", "strong", "em", "b", "i", "br", "hr", "label", "form", "input", "textarea", "select", "option", "details", "summary", "time"]
        },
        "attributes": {
          "type": "object",
          "properties": {
            "src": {"anyOf": [{"type": "string", "pattern": "^(?:https:\\/\\/[^\\s<>\\x22\\x00-\\x20]+|#[A-Za-z0-9_-]*|mailto:[A-Za-z0-9@._+-]+|tel:[+0-9 -]+|\\/api\\/projects\\/[a-f0-9]{24}\\/assets\\/[a-f0-9]{24}\\/file)$"}, {"enum": ["data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/svg+xml;base64,", "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+j6J8AAAAASUVORK5CYII="]}]},
            "href": { "type": "string", "pattern": "^(?:https:\\/\\/[^\\s<>\\x22\\x00-\\x20]+|#[A-Za-z0-9_-]*|mailto:[A-Za-z0-9@._+-]+|tel:[+0-9 -]+)$" }
          }
        },
        "style": { "type": "object" },
        "content": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "head": { "$ref": "#/$defs/component" },
        "docEl": { "$ref": "#/$defs/component" }
      },
      "allOf": [{"if": {"properties": {"type": {"const": "zero-block"}}, "required": ["type"]}, "then": {"required": ["zeroData", "attributes"], "properties": {"attributes": {"required": ["id"]}, "components": {"maxItems": 0}, "content": {"const": ""}}}, "else": {"not": {"required": ["zeroData"]}}}]
    },
    "zeroGeometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000
        },
        "y": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000
        },
        "rotation": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 20000
        },
        "anchorX": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "anchorY": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "originX": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "originY": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "container": {
          "enum": [
            "grid",
            "window"
          ]
        }
      },
      "required": [
        "x",
        "y",
        "rotation",
        "width",
        "height",
        "anchorX",
        "anchorY",
        "originX",
        "originY",
        "container"
      ]
    },
    "zeroGeometryOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000
        },
        "y": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000
        },
        "rotation": {
          "type": "number",
          "minimum": -20000,
          "maximum": 20000
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 20000
        },
        "anchorX": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "anchorY": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "originX": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "originY": {
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "container": {
          "enum": [
            "grid",
            "window"
          ]
        }
      }
    },
    "zeroBreakpointOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geometry": { "$ref": "#/$defs/zeroGeometryOverride" },
        "style": { "$ref": "#/$defs/zeroStyle" },
        "visible": { "type": "boolean" },
        "src": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:https://[^\\s<>\"\\x00-\\x20]+|/api/projects/[a-f0-9]{24}/assets/[a-f0-9]{24}/file)$"
        }
      }
    },
    "zeroStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": {
          "type": "number",
          "minimum": 1,
          "maximum": 500
        },
        "fontWeight": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "letterSpacing": {
          "type": "number",
          "minimum": -30,
          "maximum": 100
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shadowBlur": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "shadowX": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "shadowY": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "color": {
          "type": "string",
          "pattern": "^(?:#[a-fA-F0-9]{6}|transparent)$"
        },
        "fill": {
          "type": "string",
          "pattern": "^(?:#[a-fA-F0-9]{6}|transparent)$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^(?:#[a-fA-F0-9]{6}|transparent)$"
        },
        "shadowColor": {
          "type": "string",
          "pattern": "^(?:#[a-fA-F0-9]{6}|transparent)$"
        },
        "hoverFill": {
          "type": "string",
          "pattern": "^(?:#[a-fA-F0-9]{6}|transparent)$"
        },
        "hoverColor": {
          "type": "string",
          "pattern": "^(?:#[a-fA-F0-9]{6}|transparent)$"
        },
        "fontFamily": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9 ,'-]+$"
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "textDecoration": {
          "enum": [
            "none",
            "underline",
            "line-through"
          ]
        },
        "objectFit": {
          "enum": [
            "cover",
            "contain",
            "fill",
            "none"
          ]
        },
        "objectPosition": {
          "enum": [
            "center",
            "top",
            "bottom",
            "left",
            "right"
          ]
        },
        "autoHeight": {
          "type": "boolean"
        }
      }
    },
    "zeroElement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ze-[a-zA-Z0-9_-]{1,80}$"
        },
        "type": {
          "enum": [
            "text",
            "image",
            "rectangle",
            "ellipse",
            "line",
            "button",
            "tooltip",
            "group",
            "html"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "geometry": {
          "$ref": "#/$defs/zeroGeometry"
        },
        "style": {
          "$ref": "#/$defs/zeroStyle"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "tag": {
          "enum": [
            "p",
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "h6"
          ]
        },
        "src": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:https://[^\\s<>\"\\x00-\\x20]+|/api/projects/[a-f0-9]{24}/assets/[a-f0-9]{24}/file)$"
        },
        "alt": {
          "type": "string",
          "maxLength": 10000
        },
        "href": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:https://[^\\s<>\"\\x00-\\x20]+|#[a-zA-Z0-9_-]*|mailto:[a-zA-Z0-9@._+-]+|tel:[+0-9 -]+)$"
        },
        "target": {
          "enum": [
            "_self",
            "_blank"
          ]
        },
        "runs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 10000
              },
              "bold": {
                "type": "boolean"
              },
              "italic": {
                "type": "boolean"
              },
              "underline": {
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": {
            "pattern": "^(?:laptop|tablet|landscape|mobile|bp-[a-f0-9-]{8,36})$"
          },
          "patternProperties": {
            "^(?:laptop|tablet|landscape|mobile|bp-[a-f0-9-]{8,36})$": {
              "$ref": "#/$defs/zeroBreakpointOverride"
            }
          },
          "properties": {
            "laptop": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/zeroGeometryOverride"
                },
                "style": {
                  "$ref": "#/$defs/zeroStyle"
                },
                "visible": {
                  "type": "boolean"
                },
                "src": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^(?:https://[^\\s<>\"\\x00-\\x20]+|/api/projects/[a-f0-9]{24}/assets/[a-f0-9]{24}/file)$"
                }
              }
            },
            "tablet": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/zeroGeometryOverride"
                },
                "style": {
                  "$ref": "#/$defs/zeroStyle"
                },
                "visible": {
                  "type": "boolean"
                },
                "src": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^(?:https://[^\\s<>\"\\x00-\\x20]+|/api/projects/[a-f0-9]{24}/assets/[a-f0-9]{24}/file)$"
                }
              }
            },
            "landscape": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/zeroGeometryOverride"
                },
                "style": {
                  "$ref": "#/$defs/zeroStyle"
                },
                "visible": {
                  "type": "boolean"
                },
                "src": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^(?:https://[^\\s<>\"\\x00-\\x20]+|/api/projects/[a-f0-9]{24}/assets/[a-f0-9]{24}/file)$"
                }
              }
            },
            "mobile": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/zeroGeometryOverride"
                },
                "style": {
                  "$ref": "#/$defs/zeroStyle"
                },
                "visible": {
                  "type": "boolean"
                },
                "src": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^(?:https://[^\\s<>\"\\x00-\\x20]+|/api/projects/[a-f0-9]{24}/assets/[a-f0-9]{24}/file)$"
                }
              }
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "$ref": "#/$defs/zeroElement"
          }
        },
        "keepAspect": {
          "type": "boolean"
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "html": { "type": "string", "maxLength": 32768 },
            "css": { "type": "string", "maxLength": 16384 },
            "js": { "type": "string", "maxLength": 16384 }
          },
          "required": ["html", "css", "js"]
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "geometry",
        "style",
        "overrides",
        "visible",
        "locked"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "html" }
            },
            "required": ["type"]
          },
          "then": { "required": ["code"] },
          "else": { "not": { "required": ["code"] } }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "src"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "children"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "tooltip" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["content"],
            "properties": {
              "content": { "type": "string", "maxLength": 2000 }
            }
          }
        }
      ]
    },
